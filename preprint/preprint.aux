\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Static sweep.} From top: $P_{\mathrm  {sig}}$, spectral gap, edge correlation $|C_{0,N-1}|$, and robust score, versus dimerisation $\delta $ ($N=16$). $P_{\mathrm  {sig}} = 0$ throughout the trivial phase and turns on at $\delta \simeq -0.09$, matched against the analytic winding number.\relax }}{8}{figure.caption.2}\protected@file@percent }
\newlabel{fig:static}{{2}{8}{\textbf {Static sweep.} From top: $P_{\mathrm {sig}}$, spectral gap, edge correlation $|C_{0,N-1}|$, and robust score, versus dimerisation $\delta $ ($N=16$). $P_{\mathrm {sig}} = 0$ throughout the trivial phase and turns on at $\delta \simeq -0.09$, matched against the analytic winding number.\relax }{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Driven ramp.} Time course under $\delta (t)$ from $+0.4$ to $-0.4$ (top). Second: adiabatic (solid) and real (dashed) $P_{\mathrm  {sig}}$. Third: instantaneous gap. Bottom: edge correlation; its threshold crossing (red dotted line) at $t=96.4$ precedes the Hamiltonian transition $t_c=100$ (dashed grey).\relax }}{9}{figure.caption.3}\protected@file@percent }
\newlabel{fig:driven}{{3}{9}{\textbf {Driven ramp.} Time course under $\delta (t)$ from $+0.4$ to $-0.4$ (top). Second: adiabatic (solid) and real (dashed) $P_{\mathrm {sig}}$. Third: instantaneous gap. Bottom: edge correlation; its threshold crossing (red dotted line) at $t=96.4$ precedes the Hamiltonian transition $t_c=100$ (dashed grey).\relax }{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Dynamical hysteresis.} Left: open loop under the round-trip ramp at $T_{\rm  leg}=30$ (blue: forward, red: return). Right: hysteresis area vs ramp velocity in log--log scale; fitted exponent $1.05$ over $T_{\rm  leg} \in [10,400]$ (area spans a factor $\times 63$).\relax }}{10}{figure.caption.5}\protected@file@percent }
\newlabel{fig:hysteresis}{{4}{10}{\textbf {Dynamical hysteresis.} Left: open loop under the round-trip ramp at $T_{\rm leg}=30$ (blue: forward, red: return). Right: hysteresis area vs ramp velocity in log--log scale; fitted exponent $1.05$ over $T_{\rm leg} \in [10,400]$ (area spans a factor $\times 63$).\relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Decoherence robustness.} Left: maximum $P_{\mathrm  {sig}}$ amplitude vs dephasing rate $\gamma $ (log scale; threshold line). Right: final purity. The signal is detected at all $\gamma \le 0.05$ and persists at $1/2$ purity.\relax }}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:lindblad}{{5}{10}{\textbf {Decoherence robustness.} Left: maximum $P_{\mathrm {sig}}$ amplitude vs dephasing rate $\gamma $ (log scale; threshold line). Right: final purity. The signal is detected at all $\gamma \le 0.05$ and persists at $1/2$ purity.\relax }{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Noise robustness of the coupled score.} Score $S$ vs $\delta $ over the simulated exact margins (purple: topological, blue: trivial), under $\gamma _{\text  {eff}}=0.1$. The contrast stays positive where raw $P_{\mathrm  {sig}}$ alone inverts.\relax }}{11}{figure.caption.8}\protected@file@percent }
\newlabel{fig:robust}{{6}{11}{\textbf {Noise robustness of the coupled score.} Score $S$ vs $\delta $ over the simulated exact margins (purple: topological, blue: trivial), under $\gamma _{\text {eff}}=0.1$. The contrast stays positive where raw $P_{\mathrm {sig}}$ alone inverts.\relax }{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {QPU N=4 (ibm\_fez).} Coupled score $S$ and edge correlation on real hardware. Topological: $S=+0.162$, edge $=0.329$; trivial: $S=-0.175$, edge $=0.051$; contrast $\Delta S = 0.337$.\relax }}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:qpu4}{{7}{11}{\textbf {QPU N=4 (ibm\_fez).} Coupled score $S$ and edge correlation on real hardware. Topological: $S=+0.162$, edge $=0.329$; trivial: $S=-0.175$, edge $=0.051$; contrast $\Delta S = 0.337$.\relax }{figure.caption.9}{}}
